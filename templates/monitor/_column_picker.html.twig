    <hr>
    <h4>{{ __('Colunas exibidas', 'gac') }}</h4>
    <p class="text-muted small">{{ __('Marque as colunas e arraste para reordenar (arraste pelo ícone à esquerda). A ordem da lista é a ordem de exibição.', 'gac') }}</p>
    <ul class="list-group mb-3" data-gac-column-list style="max-width: 32rem;">
        {% for key in columns_ordered %}
            <li class="list-group-item d-flex align-items-center" data-column-key="{{ key }}">
                <i class="ti ti-grip-vertical gac-drag-handle me-2" style="cursor: grab;"></i>
                <div class="form-check mb-0 flex-grow-1">
                    <input class="form-check-input" type="checkbox" value="1"
                           id="gac_column_{{ key }}" data-gac-column-check
                           {{ key in chosen ? 'checked' : '' }}>
                    <label class="form-check-label" for="gac_column_{{ key }}">{{ column_choices[key] }}</label>
                </div>
            </li>
        {% endfor %}
    </ul>
    <script>
        (function () {
            const list = document.querySelector('[data-gac-column-list]');
            if (!list) { return; }

            // GLPI's bundled library here is HTML5Sortable (lukasoppermann/html5sortable,
            // confirmed by reading public/lib/sortable.js), exposed as the lowercase function
            // window.sortable(elements, options) — not the unrelated "SortableJS" package (a
            // class with Sortable.create()) its filename suggests. It also loads near the end of
            // the page (after this block runs), so init the drag behavior once the page has
            // finished loading, same pattern as the regenerate-token button placement above.
            const initDrag = function () {
                if (typeof window.sortable === 'function') {
                    window.sortable(list, { handle: '.gac-drag-handle' });
                }
            };
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initDrag);
            } else {
                initDrag();
            }

            const form = list.closest('form');
            if (!form) { return; }
            form.addEventListener('submit', function () {
                form.querySelectorAll('[data-gac-column-hidden]').forEach(function (el) { el.remove(); });
                list.querySelectorAll('[data-column-key]').forEach(function (li) {
                    const checkbox = li.querySelector('[data-gac-column-check]');
                    if (!checkbox || !checkbox.checked) { return; }
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'display_columns[]';
                    input.value = li.dataset.columnKey;
                    input.setAttribute('data-gac-column-hidden', '1');
                    form.appendChild(input);
                });
            });
        })();
    </script>
