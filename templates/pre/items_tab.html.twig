{% import 'components/form/fields_macros.html.twig' as fields %}

<div class="p-3" data-gac-pre data-protocol-id="{{ protocol.getID() }}" data-ajax-send="{{ ajax_send_url }}" data-tab-url="{{ tab_url }}">
    {% include '@gac/pre/items_toolbar.html.twig' ignore missing %}
    {% include '@gac/pre/items_import.html.twig' ignore missing %}

    {% set editing = is_draft and can_edit %}
    {% if editing %}
        <form method="post" action="{{ form_url }}">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="protocol_id" value="{{ protocol.getID() }}">
    {% endif %}

    {% set has_return_cards = (can_return and (lines|filter(l => l.is_at_supplier)|length) > 0) or (can_reopen and is_reopened) %}
    {% set status_badges = {
        pending_send: 'bg-secondary-lt',
        sending: 'bg-info-lt',
        at_supplier: 'bg-warning-lt',
        returned: 'bg-success-lt',
        lost: 'bg-danger-lt',
    } %}

    <div class="card border mb-4">
        <div class="card-header bg-body-tertiary">
            <div class="flex-grow-1">
                <h4 class="card-title mb-1"><i class="ti ti-list-details me-2"></i>{{ __('Itens do protocolo', 'gac') }}</h4>
                <div class="text-muted small">
                    {% if is_draft %}
                        {{ __('Tickets e equipamentos que serão enviados ao fornecedor.', 'gac') }}
                    {% else %}
                        {{ __('Equipamentos enviados ao fornecedor e a situação de cada um.', 'gac') }}
                    {% endif %}
                </div>
            </div>
            {% if has_return_cards %}
                <button type="button" class="btn btn-sm btn-outline-secondary" data-gac-toggle-list
                        data-label-collapse="{{ __('Recolher lista de itens', 'gac') }}"
                        data-label-expand="{{ __('Expandir lista de itens', 'gac') }}">
                    <i class="ti ti-chevron-up"></i> <span>{{ __('Recolher lista de itens', 'gac') }}</span>
                </button>
            {% endif %}
        </div>

    <div class="table-responsive" data-gac-items-list>
        <table class="table table-hover card-table mb-0">
            <thead>
                <tr>
                    <th>{{ __('Ticket', 'gac') }}</th>
                    <th>{{ __('Tipo', 'gac') }}</th>
                    <th>{{ __('Equipamento', 'gac') }}</th>
                    <th>{{ __('Patrimônio', 'gac') }}</th>
                    <th>{{ __('Nº de série', 'gac') }}</th>
                    <th>{{ __('Descrição para o fornecedor', 'gac') }}</th>
                    <th>{{ __('Situação', 'gac') }}</th>
                    <th>{{ __('Ações', 'gac') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for line in lines %}
                    <tr>
                        <td><a href="{{ line.ticket_url }}">#{{ line.tickets_id }}</a></td>
                        <td>{{ line.item_type_label }}</td>
                        <td>{{ line.item_name }}</td>
                        <td>{{ line.otherserial ?: '<span class="text-muted">—</span>'|raw }}</td>
                        <td>{{ line.serial ?: '<span class="text-muted">—</span>'|raw }}</td>
                        <td>
                            {% if editing %}
                                <textarea class="form-control" rows="2" name="description[{{ line.id }}]">{{ line.description_supplier }}</textarea>
                            {% else %}
                                {{ line.description_supplier|default('—') }}
                            {% endif %}
                        </td>
                        <td>
                            <span class="badge {{ status_badges[line.status]|default('bg-secondary-lt') }}">{{ line.status_label }}</span>
                            {% if line.outcome_label %}<div class="small text-muted mt-1">{{ line.outcome_label }}{% if line.destination_label and line.destination != 'none' %} · {{ line.destination_label }}{% endif %}</div>{% endif %}
                        </td>
                        <td>
                            {% if editing and line.can_remove_draft %}
                                <button type="submit" name="remove_line" value="{{ line.id }}" class="btn btn-sm btn-outline-danger">{{ __('Remover', 'gac') }}</button>
                            {% endif %}
                            {% include '@gac/pre/line_actions.html.twig' ignore missing with {line: line} %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="8" class="text-center text-muted">{{ __('Nenhum item neste protocolo.', 'gac') }}</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% if editing and lines is not empty %}
        <div class="card-footer">
            <button type="submit" name="save_descriptions" value="1" class="btn btn-primary">{{ __('Salvar descrições', 'gac') }}</button>
        </div>
    {% endif %}
    </div>

    {% if editing %}
        </form>
    {% endif %}

    {% include '@gac/pre/items_return_forms.html.twig' ignore missing %}

    {% if has_return_cards %}
        <script>window.gacApplyListState && window.gacApplyListState(document.querySelector('[data-gac-pre][data-protocol-id="{{ protocol.getID() }}"]'));</script>
    {% endif %}
</div>
