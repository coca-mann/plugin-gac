{% import 'components/form/fields_macros.html.twig' as fields %}
{% set gac_field = {is_horizontal: false, field_class: 'col-12', mb: 'mb-0'} %}

{% if can_return %}
    {% for line in lines %}
        {% if line.is_at_supplier %}
            <div class="card border mb-4" data-gac-return-card>
                <div class="card-header bg-body-tertiary">
                    <div>
                        <h4 class="card-title mb-1"><i class="ti ti-package-import me-2"></i>{{ __('Registrar retorno', 'gac') }}</h4>
                        <div class="text-muted small">#{{ line.tickets_id }} · {{ line.item_name }}</div>
                    </div>
                </div>
                <form method="post" action="{{ form_url }}" enctype="multipart/form-data" data-gac-return-form data-gac-ajax-form data-gac-defective='{{ defective_outcomes|json_encode|raw }}'>
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                    <input type="hidden" name="protocol_id" value="{{ protocol.getID() }}">
                    <input type="hidden" name="line_id" value="{{ line.id }}">
                    <div class="card-body">
                        <div class="text-muted small mb-3">{{ __('O resultado e o destino definem o que acontece com o ticket e com o ativo.', 'gac') }}</div>

                        <div class="fw-bold mb-2">{{ __('Resultado', 'gac') }}</div>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                {{ fields.dropdownArrayField('outcome', '', outcome_choices, __('Resultado', 'gac'), gac_field|merge({required: true, display_emptychoice: true, class: 'gac-outcome'})) }}
                            </div>
                            <div class="col-md-4" data-gac-destination-group hidden>
                                {{ fields.dropdownArrayField('destination', 'writeoff', destination_choices, __('Destino', 'gac'), gac_field|merge({class: 'gac-destination'})) }}
                            </div>
                            <div class="col-md-4">
                                {{ fields.dateField('date_return', 'now'|date('Y-m-d'), __('Data do retorno', 'gac'), gac_field) }}
                            </div>
                        </div>

                        <div class="fw-bold mb-2">{{ __('Serviço e custo', 'gac') }}</div>
                        <div class="row g-3 mb-4">
                            <div class="col-md-12">
                                <label class="col-form-label">{{ __('Serviço executado', 'gac') }}</label>
                                <textarea class="form-control" name="service_description" rows="2"></textarea>
                            </div>
                            <div class="col-md-4">
                                <label class="col-form-label">{{ __('Custo (R$)', 'gac') }}</label>
                                <input type="text" class="form-control" name="cost" inputmode="decimal" placeholder="0,00">
                            </div>
                            <div class="col-md-4">
                                <label class="col-form-label">{{ __('Nº da OS ou nota do fornecedor', 'gac') }}</label>
                                <input type="text" class="form-control" name="supplier_ref">
                            </div>
                            <div class="col-md-4">
                                {{ fields.dateField('warranty_until', '', __('Garantia até', 'gac'), gac_field|merge({clearable: true})) }}
                            </div>
                        </div>

                        <div class="fw-bold mb-2">{{ __('Documentos', 'gac') }}</div>
                        <div class="row g-3">
                            <div class="col-md-12">
                                <input type="file" class="form-control" name="attachments[]" multiple>
                                <div class="form-text">{{ __('Opcional. Ficam nos documentos do ticket e do PRE.', 'gac') }}</div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="submit" name="return" value="1" class="btn btn-primary">{{ __('Registrar retorno', 'gac') }}</button>
                    </div>
                </form>

                <div class="card-body border-top border-danger-subtle">
                    <form method="post" action="{{ form_url }}" class="row g-2 align-items-end" data-gac-ajax-form>
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                        <input type="hidden" name="protocol_id" value="{{ protocol.getID() }}">
                        <input type="hidden" name="line_id" value="{{ line.id }}">
                        <div class="col-md-9">
                            <label class="col-form-label text-danger"><i class="ti ti-alert-triangle me-1"></i>{{ __('Marcar como extraviada (justificativa obrigatória)', 'gac') }}</label>
                            <input type="text" class="form-control" name="reason">
                        </div>
                        <div class="col-md-3">
                            <button type="submit" name="lost" value="1" class="btn btn-outline-danger w-100">{{ __('Marcar como extraviada', 'gac') }}</button>
                        </div>
                    </form>
                </div>
            </div>
        {% endif %}
    {% endfor %}
{% endif %}

{% if can_reopen and is_reopened %}
    {% for line in lines %}
        {% if line.is_returned %}
            <div class="card border mb-4">
                <div class="card-header bg-body-tertiary">
                    <div>
                        <h4 class="card-title mb-1"><i class="ti ti-edit me-2"></i>{{ __('Corrigir retorno', 'gac') }}</h4>
                        <div class="text-muted small">#{{ line.tickets_id }} · {{ line.item_name }}</div>
                    </div>
                </div>
                <form method="post" action="{{ form_url }}" enctype="multipart/form-data" data-gac-ajax-form>
                    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                    <input type="hidden" name="protocol_id" value="{{ protocol.getID() }}">
                    <input type="hidden" name="line_id" value="{{ line.id }}">
                    <div class="card-body">
                        <div class="alert alert-info">
                            <i class="ti ti-info-circle me-1"></i>
                            {{ __('O resultado e o destino não mudam aqui. Corrigir o resultado é uma correção manual no ticket e no ativo.', 'gac') }}
                        </div>

                        <div class="fw-bold mb-2">{{ __('Serviço e custo', 'gac') }}</div>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                {{ fields.dateField('date_return', line.date_return, __('Data do retorno', 'gac'), gac_field) }}
                            </div>
                            <div class="col-md-8">
                                <label class="col-form-label">{{ __('Serviço executado', 'gac') }}</label>
                                <textarea class="form-control" name="service_description" rows="2">{{ line.service_description }}</textarea>
                            </div>
                            <div class="col-md-4">
                                <label class="col-form-label">{{ __('Custo (R$)', 'gac') }}</label>
                                <input type="text" class="form-control" name="cost" inputmode="decimal" value="{{ line.cost is not null ? line.cost|number_format(2, ',', '') : '' }}">
                            </div>
                            <div class="col-md-4">
                                <label class="col-form-label">{{ __('Nº da OS ou nota do fornecedor', 'gac') }}</label>
                                <input type="text" class="form-control" name="supplier_ref" value="{{ line.supplier_ref }}">
                            </div>
                            <div class="col-md-4">
                                {{ fields.dateField('warranty_until', line.warranty_until, __('Garantia até', 'gac'), gac_field|merge({clearable: true})) }}
                            </div>
                        </div>

                        <div class="fw-bold mb-2">{{ __('Documentos', 'gac') }}</div>
                        <div class="row g-3">
                            <div class="col-md-12">
                                <input type="file" class="form-control" name="attachments[]" multiple>
                                <div class="form-text">{{ __('Opcional. Ficam nos documentos do ticket e do PRE.', 'gac') }}</div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button type="submit" name="correct" value="1" class="btn btn-primary">{{ __('Salvar correção', 'gac') }}</button>
                    </div>
                </form>
            </div>
        {% endif %}
    {% endfor %}
{% endif %}
